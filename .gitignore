# Secrets: never upload API keys to GitHub
.env

# Python's automatic files and your virtual environment
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# macOS
.DS_Store

# Runtime records contain personal profiles and should not be committed.
data/users.json
data/maintenance_history.json
data/prompt_records.json
data/*.tmp

# Keep personal fuel records and review decisions out of Git.
data/fuel_history.json
data/fuel_assessments.json
data/fuel_reviews.json
data/fuel_*.json.tmp

# Temporary pytest output
.pytest_temp*/
